dbMemo "SQL" ="SELECT p.ProductID, p.MarketingLineID, mktLines.MarketingLine, mktLines.Marketin"
    "gCategoryID, mktCats.MarketingCategory, p.Barcode, p.HSCode, p.ProductName_en, p"
    ".ProductName_vn, p.PackageTypeID, pt.PackageType, p.Capacity, p.CapacityUnitID, "
    "cunits.CapacityUnit, p.Capacity_oz, p.Price_vnd, p.Price_usd, p.Length_cm, p.Wid"
    "th_cm, p.Height_cm, p.Weight_gram, p.Ingredients, p.USP_en, p.USP_vn, p.HowToUse"
    "_en, p.HowToUse_vn, p.ImagePath, p.OuterPaperBox, p.ShelfLife_month, p.ChangeDat"
    "e, p.InsertDate, p.IsActive\015\012FROM ((Products AS p LEFT JOIN PackageTypes A"
    "S pt ON p.PackageTypeID = pt.PackageTypeID) LEFT JOIN (MarketingLines AS mktLine"
    "s LEFT JOIN MarketingCategories AS mktCats ON mktLines.MarketingCategoryID = mkt"
    "Cats.MarketingCategoryID) ON p.MarketingLineID = mktLines.MarketingLineID) LEFT "
    "JOIN CapacityUnits AS cunits ON p.CapacityUnitID = cunits.CapacityUnitID\015\012"
    "ORDER BY p.ProductID;\015\012"
dbMemo "Connect" =""
dbBoolean "ReturnsRecords" ="-1"
dbInteger "ODBCTimeout" ="60"
